{
  "layout": {
    "type": "layout",
    "pages": [
      "connection-page",
      "display-page"
    ],
    "connection-page": {
      "type": "page",
      "title": "Connection",
      "sections": [
        "connection-section",
        "polling-section"
      ]
    },
    "display-page": {
      "type": "page",
      "title": "Display",
      "sections": [
        "panel-section",
        "details-section"
      ]
    },
    "connection-section": {
      "type": "section",
      "title": "Clankermux API",
      "keys": [
        "api-url",
        "connection-note"
      ]
    },
    "polling-section": {
      "type": "section",
      "title": "Polling",
      "keys": [
        "refresh-interval",
        "request-timeout"
      ]
    },
    "details-section": {
      "type": "section",
      "title": "Popup",
      "keys": [
        "show-scoped-limits"
      ]
    },
    "panel-section": {
      "type": "section",
      "title": "Panel",
      "keys": [
        "panel-display"
      ]
    }
  },
  "api-url": {
    "type": "entry",
    "default": "http://127.0.0.1:8080",
    "description": "Server URL (hostname or IP address)",
    "tooltip": "Base URL of Clankermux's public widget API, for example http://127.0.0.1:8080 or http://clankermux.example.test:8080"
  },
  "connection-note": {
    "type": "label",
    "description": "The applet reads Clankermux's unauthenticated, read-only /public/v1 accounts, status, and workloads endpoints (API 2026.9.36 or newer)."
  },
  "refresh-interval": {
    "type": "spinbutton",
    "default": 30,
    "min": 10,
    "max": 900,
    "step": 10,
    "units": "seconds",
    "description": "Refresh accounts and status every"
  },
  "request-timeout": {
    "type": "spinbutton",
    "default": 8,
    "min": 2,
    "max": 60,
    "step": 1,
    "units": "seconds",
    "description": "Request timeout"
  },
  "show-scoped-limits": {
    "type": "switch",
    "default": true,
    "description": "Show model-family indicators and utilization bars"
  },
  "panel-display": {
    "type": "combobox",
    "default": "usage",
    "description": "Panel display",
    "options": {
      "Combined weekly usage": "usage",
      "Forecast advice": "forecast"
    },
    "tooltip": "Usage averages the weekly percentages across each provider's accounts, with equal weight per account. Forecast advice shows server guidance until the next weekly reset."
  }
}
